# Browser-visible build configuration. NEXT_PUBLIC_* values are never secrets.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_STATIC_EXPORT=false
NEXT_PUBLIC_RULEQUANT_ACCESS_GATE=false
NEXT_PUBLIC_RULEQUANT_LOCAL_GATE=false
NEXT_PUBLIC_RULEQUANT_ACCESS_TOKEN=

# Server-side access and synchronization.
RULEQUANT_ADMIN_TOKEN=
CRON_SECRET=
RULEQUANT_DRAW_SOURCE_URL=
RULEQUANT_DRAW_IMPORT_URL=
RULEQUANT_DRAW_FROM_YEAR=
RULEQUANT_DRAW_TO_YEAR=
RULEQUANT_SYNC_FROM_YEAR=
RULEQUANT_SYNC_TO_YEAR=
RULEQUANT_REQUIRE_LIVE_SOURCE=false

# Server-side cloud state.
DATABASE_URL=
POSTGRES_URL=
POSTGRES_PRISMA_URL=
RULEQUANT_CLOUD_STATE_URL=
RULEQUANT_GITHUB_REPO=
RULEQUANT_GITHUB_BRANCH=main
RULEQUANT_GITHUB_STATE_PATH=public/static-cloud-state.json
RULEQUANT_GITHUB_TOKEN=
GITHUB_TOKEN=
